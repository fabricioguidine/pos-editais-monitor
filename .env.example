# =====================================================================
# pos-editais-monitor - example environment file
# Copy to .env and fill in. NEVER commit the real .env.
# =====================================================================

# ----- App ---------------------------------------------------------------
PEM_ENV=development                # development | staging | production
PEM_LOG_LEVEL=INFO                 # DEBUG | INFO | WARNING | ERROR
PEM_LOG_FORMAT=console             # console | json
PEM_API_KEY=change-me              # protects write/admin endpoints

# ----- Database ----------------------------------------------------------
PEM_DATABASE_URL=postgresql+asyncpg://pem:pem@localhost:5432/pem
PEM_DATABASE_POOL_SIZE=10
PEM_DATABASE_MAX_OVERFLOW=20

# ----- Redis (cache, rate-limit token bucket, dedup TTL) -----------------
PEM_REDIS_URL=redis://localhost:6379/0

# ----- Scraping ----------------------------------------------------------
PEM_HTTP_TIMEOUT_SECONDS=30
PEM_HTTP_MAX_RETRIES=5
PEM_HTTP_USER_AGENT=pos-editais-monitor/0.1 (+https://github.com/fabricioguidine/pos-editais-monitor; contact: fabricioguidine@gmail.com)
PEM_RATE_LIMIT_RPS=0.5             # 1 req every 2 seconds per host (conservative)
PEM_RESPECT_ROBOTS=true
PEM_PLAYWRIGHT_HEADLESS=true
PEM_PLAYWRIGHT_POOL_SIZE=2

# ----- LLM fallback (Anthropic Claude) -----------------------------------
PEM_LLM_ENABLED=true
PEM_LLM_PROVIDER=anthropic
PEM_LLM_MODEL=claude-haiku-4-5-20251001
PEM_LLM_CONFIDENCE_THRESHOLD=0.65   # rules-based confidence below this -> fallback
PEM_LLM_MAX_TOKENS=1500
ANTHROPIC_API_KEY=sk-ant-...

# ----- Notifications (email = canal primario) ----------------------------
PEM_EMAIL_ENABLED=true
PEM_SMTP_HOST=smtp.gmail.com
PEM_SMTP_PORT=587
PEM_SMTP_USERNAME=fabricioguidine@gmail.com
PEM_SMTP_PASSWORD=                # gerar App Password no Google Account
PEM_SMTP_FROM=fabricioguidine@gmail.com
PEM_NOTIFY_TO=fabricioguidine@gmail.com
PEM_NOTIFY_ONLY_ON_MATCH=true     # nao envia email se nao houver matches no ciclo
PEM_NOTIFY_DIGEST_CRON=0 7 * * *  # 07:00 todo dia (timezone do container)

PEM_TELEGRAM_ENABLED=false        # opcional, secundario
PEM_TELEGRAM_BOT_TOKEN=
PEM_TELEGRAM_CHAT_ID=

# ----- e-MEC (cadastro oficial de IES) -----------------------------------
PEM_EMEC_BASE_URL=https://emec.mec.gov.br
PEM_EMEC_CACHE_TTL_HOURS=168      # 7 dias - cadastro muda raramente
PEM_EMEC_ONLY_ACTIVE=true         # exclui IES descredenciadas
PEM_EMEC_ONLY_PUBLIC=true         # exclui privadas pagas

# ----- Matching engine (perfil do usuario) -------------------------------
PEM_MATCH_MIN_SCORE=0.70          # precision-first, threshold alto
PEM_MATCH_DEFAULT_PROFILE=fabricio
PEM_MATCH_REQUIRE_FREE=true       # exige gratuito explicitamente

# ----- Observability -----------------------------------------------------
PEM_OTEL_ENABLED=false
PEM_OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
PEM_PROMETHEUS_ENABLED=true
PEM_PROMETHEUS_PORT=9090

# ----- Scheduling --------------------------------------------------------
PEM_SCHEDULER_ENABLED=true
PEM_SCHEDULER_DEFAULT_INTERVAL_MINUTES=180   # 3 hours per source by default
